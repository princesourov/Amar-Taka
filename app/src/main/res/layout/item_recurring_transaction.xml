<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recurringTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Rent" />

            <TextView
                android:id="@+id/recurringFrequency"
                android:layout_width="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="Monthly" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/recurringAmount"
                android:layout_width="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="৳12,000.00" />

            <TextView
                android:id="@+id/recurringNextRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="Next: 1 Sep" />
        </LinearLayout>
    </LinearLayout>

        <TextView
            android:id="@+id/recurringAttention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_md"
            android:fontFamily="@font/poppins_semibold"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/color_warning"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recurringHistory"
                style="@style/Widget.Hisab.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/recurring_action_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recurringToggle"
                style="@style/Widget.Hisab.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recurringDelete"
                style="@style/Widget.Hisab.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/action_delete"
                android:textColor="@color/color_negative" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
