<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Static custom palette rather than Material You dynamic color, on purpose —
         a finance app benefits from one consistent, deliberate brand identity.
         Premium fintech design system: forest green, cream background, white cards. -->
    <style name="Theme.Hisab" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colour roles -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorPrimaryContainer">@color/color_secondary</item>
        <item name="colorOnPrimaryContainer">@color/color_on_secondary</item>
        <item name="colorSecondary">@color/color_primary</item>
        <item name="colorOnSecondary">@color/color_on_primary</item>
        <item name="colorSecondaryContainer">@color/color_secondary</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_on_surface</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/color_surface</item>
        <item name="colorSurfaceContainerLow">@color/color_surface</item>
        <item name="colorSurfaceContainer">@color/color_surface</item>
        <item name="colorSurfaceContainerHigh">@color/color_surface</item>
        <item name="colorSurfaceContainerHighest">@color/color_surface_variant</item>
        <item name="colorOutline">@color/color_outline</item>
        <item name="colorOutlineVariant">@color/color_divider</item>
        <item name="colorError">@color/color_negative</item>
        <item name="colorOnError">@color/color_on_primary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/color_status_bar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Soft green-tinted elevation shadows -->
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/color_shadow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/color_shadow</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Hisab.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Hisab.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Hisab.Large</item>

        <!-- Typography -->
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Hisab.DisplaySmall</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Hisab.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Hisab.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Hisab.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Hisab.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Hisab.TitleSmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Hisab.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Hisab.LabelMedium</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Hisab.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Hisab.BodySmall</item>

        <!-- Component styles -->
        <item name="materialCardViewStyle">@style/Widget.Hisab.Card</item>
        <item name="materialButtonStyle">@style/Widget.Hisab.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Hisab.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.Hisab.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.Hisab.BottomNav</item>
        <item name="floatingActionButtonStyle">@style/Widget.Hisab.FAB</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.Hisab.Progress.Linear</item>
        <item name="popupMenuStyle">@style/Widget.Hisab.PopupMenu</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Hisab.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Hisab.MaterialAlertDialog</item>
    </style>
</resources>
