rules_version = '2';

// Every piece of financial data lives under /users/{userId}/... . A signed-in
// user may only read or write documents nested under their OWN uid — this is
// the enforcement for spec Section 3: "One user must NEVER be able to access
// another user's financial data."
//
// Apply this in the Firebase console under Firestore Database > Rules, or via
// the Firebase CLI: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Covers every subcollection: accounts, transactions, people, categories,
      // budgets, savingsGoals, recurringTransactions, reminders.
      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
